rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function validText(field, max) { return field is string && field.size() <= max; }
    function validStoredFile(file) {
      return file is map
        && file.keys().hasOnly(['name','meta','type','url'])
        && validText(file.name, 180)
        && validText(file.meta, 80)
        && validText(file.type, 100)
        && validText(file.url, 2048);
    }
    function validStoredFileAt(files, index) {
      return files.size() <= index || validStoredFile(files[index]);
    }
    function validStoredFiles(files) {
      return files is list && files.size() <= 10
        && validStoredFileAt(files, 0) && validStoredFileAt(files, 1)
        && validStoredFileAt(files, 2) && validStoredFileAt(files, 3)
        && validStoredFileAt(files, 4) && validStoredFileAt(files, 5)
        && validStoredFileAt(files, 6) && validStoredFileAt(files, 7)
        && validStoredFileAt(files, 8) && validStoredFileAt(files, 9);
    }
    function validStoredUrlAt(urls, index) {
      return urls.size() <= index || validText(urls[index], 2048);
    }
    function validStoredUrls(urls) {
      return urls is list && urls.size() <= 10
        && validStoredUrlAt(urls, 0) && validStoredUrlAt(urls, 1)
        && validStoredUrlAt(urls, 2) && validStoredUrlAt(urls, 3)
        && validStoredUrlAt(urls, 4) && validStoredUrlAt(urls, 5)
        && validStoredUrlAt(urls, 6) && validStoredUrlAt(urls, 7)
        && validStoredUrlAt(urls, 8) && validStoredUrlAt(urls, 9);
    }
    function ownsUser(userId) { return signedIn() && request.auth.uid == userId; }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('deactivated' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deactivated == false);
    }
    function publicProfile() {
      return get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data;
    }
    function profileUsername() {
      return exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }
    function paidPlan() {
      return exists(/databases/$(database)/documents/entitlements/$(request.auth.uid))
        && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.plan in ['Student+','Power']
        && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function channelExists(channelId) {
      return exists(/databases/$(database)/documents/channels/$(channelId));
    }
    function isChannelMember(channelId) {
      return activeUser() && (
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + channelId))
        || get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid
      );
    }
    function validMessageParticipants(data) {
      return data.participants is list && (
        (data.participants.size() == 1
          && data.participants[0] == request.auth.uid
          && data.conversationId == 'saved_' + request.auth.uid)
        || (data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] != data.participants[1]
          && request.auth.uid in data.participants
          && (data.conversationId == data.participants[0] + '_' + data.participants[1]
            || data.conversationId == data.participants[1] + '_' + data.participants[0]))
      );
    }
    function messagePeer(data) {
      return data.participants[0] == request.auth.uid ? data.participants[1] : data.participants[0];
    }
    function messagingAllowed(data) {
      return data.participants.size() == 1 || (
        !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + messagePeer(data)))
        && !exists(/databases/$(database)/documents/blocks/$(messagePeer(data) + '_' + request.auth.uid))
      );
    }
    function ratePath(action) {
      return /databases/$(database)/documents/rateLimits/$(request.auth.uid + '_' + action);
    }
    function rateConsumed(action, maxCount, windowDuration) {
      let path = ratePath(action);
      let after = getAfter(path).data;
      return after.uid == request.auth.uid
        && after.action == action
        && after.updatedAt == request.time
        && after.count <= maxCount
        && (
          (!exists(path)
            && after.count == 1
            && after.windowStartedAt == request.time)
          || (exists(path) && (
            (request.time < get(path).data.windowStartedAt + windowDuration
              && after.windowStartedAt == get(path).data.windowStartedAt
              && after.count == get(path).data.count + 1)
            || (request.time >= get(path).data.windowStartedAt + windowDuration
              && after.windowStartedAt == request.time
              && after.count == 1)
          ))
        );
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || admin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['username','email','course','yearLevel','bio','photoURL','deactivated','apkPromptDismissed','termsVersion','acceptedTermsAt','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['username','email','course','yearLevel','bio','photoURL','deactivated','apkPromptDismissed','termsVersion','acceptedTermsAt','createdAt','updatedAt'])
        && validText(request.resource.data.username, 80)
        && request.resource.data.username.size() > 0
        && validText(request.resource.data.email, 254)
        && request.resource.data.email == request.auth.token.email
        && validText(request.resource.data.course, 120)
        && validText(request.resource.data.yearLevel, 40)
        && validText(request.resource.data.bio, 500)
        && validText(request.resource.data.photoURL, 2048)
        && request.resource.data.deactivated == false
        && request.resource.data.apkPromptDismissed == false
        && request.resource.data.termsVersion == '2026-08'
        && request.resource.data.acceptedTermsAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsUser(userId)
        && resource.data.deactivated == false
        && request.resource.data.keys().hasOnly(['username','email','course','yearLevel','bio','photoURL','deactivated','apkPromptDismissed','termsVersion','acceptedTermsAt','createdAt','updatedAt'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && validText(request.resource.data.username, 80)
        && request.resource.data.username.size() > 0
        && validText(request.resource.data.email, 254)
        && validText(request.resource.data.course, 120)
        && validText(request.resource.data.yearLevel, 40)
        && validText(request.resource.data.bio, 500)
        && validText(request.resource.data.photoURL, 2048)
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.deactivated == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','course','yearLevel','bio','photoURL','updatedAt']))
          || (request.resource.data.deactivated == false
            && request.resource.data.apkPromptDismissed is bool
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apkPromptDismissed','updatedAt']))
          || (request.resource.data.deactivated == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deactivated','updatedAt']))
        );
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if activeUser() || admin();
      allow create, update: if activeUser() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username','course','yearLevel','bio','photoURL','updatedAt'])
        && validText(request.resource.data.username, 80)
        && validText(request.resource.data.course, 120)
        && validText(request.resource.data.yearLevel, 40)
        && validText(request.resource.data.bio, 500)
        && validText(request.resource.data.photoURL, 2048)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId}/channelSettings/{channelId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow create, update: if activeUser() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['channelId','muted','updatedAt'])
        && request.resource.data.channelId == channelId
        && request.resource.data.muted is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if activeUser() && request.auth.uid == userId;
    }

    match /posts/{postId} {
      // The current client uses one collection subscription for the feed.
      // Keep this authenticated until the feed is migrated to per-channel
      // queries; anonymous enumeration is still prevented.
      allow read: if activeUser() || admin();
      allow create: if activeUser() && rateConsumed('post', 5, duration.value(60, 's'))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id','initials','authorId','author','authorPhotoURL','ago','course','channelId','icon','text','comments','imageURL','images','audioURL','audioDuration','file','files','createdAt'])
        && request.resource.data.channelId is string
        && channelExists(request.resource.data.channelId)
        && isChannelMember(request.resource.data.channelId)
        && validText(request.resource.data.author, 80)
        && request.resource.data.author == publicProfile().username
        && validText(request.resource.data.initials, 4)
        && validText(request.resource.data.course, 120)
        && (request.resource.data.text == null || validText(request.resource.data.text, 4000))
        && request.resource.data.comments == 0
        && request.resource.data.id == postId
        && request.resource.data.createdAt == request.time
        && (!('imageURL' in request.resource.data) || request.resource.data.imageURL == null || validText(request.resource.data.imageURL, 2048))
        && (!('images' in request.resource.data) || validStoredUrls(request.resource.data.images))
        && (!('audioURL' in request.resource.data) || request.resource.data.audioURL == null || validText(request.resource.data.audioURL, 2048))
        && (!('files' in request.resource.data) || validStoredFiles(request.resource.data.files))
        && (!('images' in request.resource.data) || !('files' in request.resource.data) || request.resource.data.images.size() + request.resource.data.files.size() <= 10)
        && (!('audioDuration' in request.resource.data) || (request.resource.data.audioDuration is int && request.resource.data.audioDuration >= 0 && request.resource.data.audioDuration <= 600));
      allow update: if activeUser() && resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id','initials','authorId','author','authorPhotoURL','ago','course','channelId','icon','text','comments','imageURL','images','audioURL','audioDuration','file','files','createdAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.channelId == resource.data.channelId
        && isChannelMember(resource.data.channelId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.time - resource.data.createdAt < duration.value(30, 'm')
        && validText(request.resource.data.author, 80)
        && validText(request.resource.data.course, 120)
        && validText(request.resource.data.text, 4000);
      allow delete: if (activeUser() && resource.data.authorId == request.auth.uid) || admin();
    }

    match /channels/{channelId} {
      allow read: if activeUser() || admin();
      allow create: if activeUser() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name','course','sub','access','desc','icon','cls','members','ownerId','createdAt','imageURL'])
        && validText(request.resource.data.name, 80)
        && request.resource.data.name.size() > 0
        && validText(request.resource.data.course, 120)
        && validText(request.resource.data.sub, 120)
        && validText(request.resource.data.desc, 500)
        && validText(request.resource.data.icon, 4)
        && validText(request.resource.data.cls, 40)
        && request.resource.data.members is int
        && request.resource.data.members == 1
        && request.resource.data.access in ['Public','Private']
        && (request.resource.data.access == 'Public' || paidPlan())
        && request.resource.data.createdAt == request.time;
      allow update: if activeUser() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','course','sub','access','desc','icon','cls','imageURL','updatedAt'])
          && request.resource.data.keys().hasOnly(['name','course','sub','access','desc','icon','cls','members','ownerId','createdAt','imageURL','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && validText(request.resource.data.name, 80)
          && validText(request.resource.data.course, 120)
          && validText(request.resource.data.sub, 120)
          && validText(request.resource.data.desc, 500)
          && (!('imageURL' in request.resource.data) || validText(request.resource.data.imageURL, 2048))
          && request.resource.data.access in ['Public','Private']
          && (request.resource.data.access == 'Public' || resource.data.access == 'Private' || paidPlan()))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members is int
          && request.resource.data.members >= 0
          && ((!exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + channelId))
              && existsAfter(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + channelId))
              && request.resource.data.members == resource.data.members + 1)
            || (exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + channelId))
              && !existsAfter(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + channelId))
              && request.resource.data.members == resource.data.members - 1)))
      );
      allow delete: if activeUser() && resource.data.ownerId == request.auth.uid && resource.data.members <= 1;
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['authorId','author','authorPhotoURL','text','imageURL','audioURL','audioDuration','parentId','createdAt'])
        && validText(request.resource.data.author, 80)
        && request.resource.data.author == profileUsername()
        && validText(request.resource.data.text, 2000)
        && validText(request.resource.data.authorPhotoURL, 2048)
        && (request.resource.data.imageURL == null || validText(request.resource.data.imageURL, 2048))
        && (request.resource.data.audioURL == null || validText(request.resource.data.audioURL, 2048))
        && (!('audioDuration' in request.resource.data) || (
          request.resource.data.audioDuration is int
          && request.resource.data.audioDuration >= 0
          && request.resource.data.audioDuration <= 600
        ))
        && request.resource.data.createdAt == request.time
        && (request.resource.data.parentId == null || (
          request.resource.data.parentId is string
          && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId))
          && get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId)).data.parentId == null
        ));
      allow delete: if (activeUser() && resource.data.authorId == request.auth.uid) || admin();
      allow update: if false;
    }

    match /memberships/{membershipId} {
      allow read: if activeUser() && (
        resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerId == request.auth.uid
      );
      allow create: if activeUser() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','channelId','joinedAt'])
        && request.resource.data.channelId is string
        && membershipId == request.auth.uid + '_' + request.resource.data.channelId
        && request.resource.data.joinedAt == request.time
        && existsAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId))
        && (
          getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.access == 'Public'
          || getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerId == request.auth.uid
        )
        && getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.members
          == (exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId))
            ? get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.members + 1
            : 1);
      allow delete: if activeUser() && (
        resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerId == request.auth.uid
      )
        && existsAfter(/databases/$(database)/documents/channels/$(resource.data.channelId))
        && getAfter(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.members
          == get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.members - 1;
      allow update: if false;
    }

    match /users/{userId}/saved/{postId} {
      allow read: if activeUser() && ownsUser(userId);
      allow create: if activeUser() && ownsUser(userId)
        && request.resource.data.keys().hasOnly(['postId','savedAt'])
        && request.resource.data.postId == postId
        && request.resource.data.savedAt == request.time;
      allow delete: if activeUser() && ownsUser(userId);
      allow update: if false;
    }

    match /messages/{messageId} {
      allow create: if activeUser()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.keys().hasOnly(['conversationId','participants','senderId','text','type','post','postId','file','replyTo','seenBy','playedBy','createdAt'])
        && validMessageParticipants(request.resource.data)
        && messagingAllowed(request.resource.data)
        && validText(request.resource.data.conversationId, 160)
        && (request.resource.data.text == null || validText(request.resource.data.text, 4000))
        && request.resource.data.type in ['text','postLink','savedPost','attachment']
        && request.resource.data.seenBy is list
        && request.resource.data.seenBy.size() == 1
        && request.resource.data.seenBy[0] == request.auth.uid
        && (!('playedBy' in request.resource.data) || (
          request.resource.data.type == 'attachment'
          && request.resource.data.file.type.matches('^audio/.*')
          && request.resource.data.playedBy is list
          && request.resource.data.playedBy.size() == 1
          && request.resource.data.playedBy[0] == request.auth.uid
        ))
        && request.resource.data.createdAt == request.time
        && (!('postId' in request.resource.data) || request.resource.data.postId is string)
        && (!('replyTo' in request.resource.data) || (
          request.resource.data.replyTo is map
          && request.resource.data.replyTo.keys().hasOnly(['id','sender','text'])
          && validText(request.resource.data.replyTo.id, 160)
          && validText(request.resource.data.replyTo.sender, 80)
          && validText(request.resource.data.replyTo.text, 300)
        ))
        && (!('file' in request.resource.data) || (
          request.resource.data.file is map
          && request.resource.data.file.keys().hasOnly(['name','meta','type','url','duration'])
          && validText(request.resource.data.file.name, 180)
          && validText(request.resource.data.file.meta, 80)
          && validText(request.resource.data.file.type, 100)
          && validText(request.resource.data.file.url, 2048)
          && (!('duration' in request.resource.data.file) || (request.resource.data.file.duration is number && request.resource.data.file.duration >= 0 && request.resource.data.file.duration <= 600))
        ))
        && (!('post' in request.resource.data) || (
          request.resource.data.post is map
          && request.resource.data.post.keys().hasOnly(['id','course','author','authorId','text','imageURL','images','audioURL','file','files'])
          && validText(request.resource.data.post.id, 160)
          && validText(request.resource.data.post.course, 120)
          && validText(request.resource.data.post.author, 80)
          && validText(request.resource.data.post.authorId, 160)
          && validText(request.resource.data.post.text, 4000)
          && (!('images' in request.resource.data.post) || validStoredUrls(request.resource.data.post.images))
          && (!('files' in request.resource.data.post) || validStoredFiles(request.resource.data.post.files))
          && (!('images' in request.resource.data.post) || !('files' in request.resource.data.post) || request.resource.data.post.images.size() + request.resource.data.post.files.size() <= 10)
        ));
      allow read: if activeUser() && request.auth.uid in resource.data.participants;
      allow delete: if (activeUser() && resource.data.senderId == request.auth.uid && resource.data.seenBy.toSet().size() == 1) || admin();
      allow update: if activeUser() && request.auth.uid in resource.data.participants && (
        (resource.data.senderId == request.auth.uid
          && resource.data.type == 'text'
          && request.time - resource.data.createdAt < duration.value(30, 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
          && request.resource.data.editedAt == request.time
          && validText(request.resource.data.text, 4000))
        || (resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy','seenAt'])
          && request.resource.data.seenAt == request.time
          && request.auth.uid in request.resource.data.seenBy
          && (!('seenBy' in resource.data) || request.resource.data.seenBy.toSet().hasAll(resource.data.seenBy.toSet()))
          && request.resource.data.seenBy.size() <= resource.data.participants.size())
        || (resource.data.senderId != request.auth.uid
          && resource.data.type == 'attachment'
          && resource.data.file.type.matches('^audio/.*')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playedBy','playedAt'])
          && request.resource.data.playedAt == request.time
          && request.auth.uid in request.resource.data.playedBy
          && (!('playedBy' in resource.data) || request.resource.data.playedBy.toSet().hasAll(resource.data.playedBy.toSet()))
          && request.resource.data.playedBy.size() <= resource.data.participants.size())
      );
    }

    match /friendRequests/{requestId} {
      allow read: if activeUser() && (
        resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );
      allow create: if activeUser() && rateConsumed('friendRequest', 10, duration.value(3600, 's'))
        && request.resource.data.keys().hasOnly(['senderId','receiverId','status','createdAt','updatedAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.receiverId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.receiverId))
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + request.resource.data.receiverId))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.receiverId + '_' + request.auth.uid));
      allow update: if activeUser()
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if activeUser() && (
        resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );
    }

    match /blocks/{blockId} {
      allow read: if activeUser() && resource.data.blockerId == request.auth.uid;
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['blockerId','blockedId','createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && request.resource.data.createdAt == request.time
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if activeUser() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /entitlements/{userId} {
      allow read: if (activeUser() && request.auth.uid == userId) || admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['plan','storageAddonMB','expiresAt','updatedAt','source'])
        && request.resource.data.plan in ['Free','Student+','Power']
        && request.resource.data.storageAddonMB is int
        && request.resource.data.storageAddonMB >= 0
        && ((request.resource.data.plan == 'Free' && request.resource.data.expiresAt == null)
          || (request.resource.data.plan in ['Student+','Power']
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time))
        && request.resource.data.source in ['admin','payment']
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if activeUser() && rateConsumed('report', 5, duration.value(3600, 's'))
        && request.resource.data.keys().hasOnly(['type','targetId','reason','userId','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validText(request.resource.data.type, 30)
        && validText(request.resource.data.targetId, 200)
        && validText(request.resource.data.reason, 500);
      allow read, update, delete: if admin();
    }

    match /admin/{document=**} {
      allow read, write: if admin();
    }

    match /rateLimits/{rateId} {
      allow read: if activeUser() && rateId in [
        request.auth.uid + '_message',
        request.auth.uid + '_post',
        request.auth.uid + '_comment',
        request.auth.uid + '_friendRequest',
        request.auth.uid + '_report'
      ];
      allow create, update: if activeUser()
        && rateId == request.auth.uid + '_' + request.resource.data.action
        && request.resource.data.keys().hasOnly(['uid','action','count','windowStartedAt','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count is int
        && request.resource.data.count > 0
        && request.resource.data.action in ['message','post','comment','friendRequest','report']
        && (
          (request.resource.data.action == 'message' && rateConsumed('message', 20, duration.value(60, 's')))
          || (request.resource.data.action == 'post' && rateConsumed('post', 5, duration.value(60, 's')))
          || (request.resource.data.action == 'comment' && rateConsumed('comment', 15, duration.value(60, 's')))
          || (request.resource.data.action == 'friendRequest' && rateConsumed('friendRequest', 10, duration.value(3600, 's')))
          || (request.resource.data.action == 'report' && rateConsumed('report', 5, duration.value(3600, 's')))
        );
      allow delete: if false;
    }
  }
}
