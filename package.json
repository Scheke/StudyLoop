{
  "name": "studyloop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:functions": "npm --prefix functions run check",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-studyloop-v2 \"node --test tests/rules.test.cjs\"",
    "verify": "npm run check:functions && npm run test:rules && npm run build"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.29.0",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "firebase": "^12.17.1"
  },
