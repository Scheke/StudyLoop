rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function activeRequester() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (!('deactivated' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data)
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.deactivated == false);
    }
    function owns(userId) { return activeRequester() && request.auth.uid == userId; }
    function v2Requester() { return activeRequester() && request.auth.token.email_verified == true; }
    function isChannelMember(channelId) {
      return activeRequester() && (
        firestore.exists(/databases/(default)/documents/memberships/$(request.auth.uid + '_' + channelId))
        || firestore.get(/databases/(default)/documents/channels/$(channelId)).data.ownerId == request.auth.uid
      );
    }
    function isConversationParticipant(conversationId) {
      return activeRequester()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
    }
    function paidPlan(userId) {
      return firestore.exists(/databases/(default)/documents/entitlements/$(userId))
        && firestore.get(/databases/(default)/documents/entitlements/$(userId)).data.plan in ['Student+','Power']
        && firestore.get(/databases/(default)/documents/entitlements/$(userId)).data.expiresAt > request.time;
    }
    function storageLimit(userId) {
      return paidPlan(userId)
        ? (firestore.get(/databases/(default)/documents/entitlements/$(userId)).data.plan == 'Student+'
          ? 2 * 1024 * 1024 * 1024
          : 4 * 1024 * 1024 * 1024)
        : 100 * 1024 * 1024;
    }
    function storageUsed(userId) {
      return firestore.exists(/databases/(default)/documents/usage/$(userId))
        && 'storageBytes' in firestore.get(/databases/(default)/documents/usage/$(userId)).data
        ? firestore.get(/databases/(default)/documents/usage/$(userId)).data.storageBytes
        : 0;
    }
    function withinQuota(userId) { return storageUsed(userId) + request.resource.size <= storageLimit(userId); }
    function safeImage() { return request.resource.contentType in ['image/jpeg','image/png','image/webp']; }
    function safeAudio() { return request.resource.contentType in ['audio/mpeg','audio/mp4','audio/ogg','audio/wav','audio/webm']; }
    function safeDocument() { return request.resource.contentType in ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-powerpoint','application/vnd.openxmlformats-officedocument.presentationml.presentation','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','text/plain']; }
    function safeStudyFile() { return safeImage() || safeAudio() || safeDocument(); }

    match /users/{userId}/profile/{fileName} {
      allow read: if activeRequester();
      allow create: if owns(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && withinQuota(userId)
        && safeImage()
        && fileName.matches('[A-Za-z0-9._-]{1,120}');
      allow delete: if owns(userId);
      allow update: if false;
    }
    match /users/{userId}/channels/{channelId}/{fileName} {
      allow read: if activeRequester();
      allow create: if owns(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && withinQuota(userId)
        && safeImage()
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }
    match /users/{userId}/saved/{fileName} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.size <= 200 * 1024 * 1024
        && withinQuota(userId)
        && safeStudyFile()
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }
    match /users/{userId}/posts/{postId}/{fileName} {
      // Preserve older post attachments without making them public: access is
      // derived from the referenced post's channel membership.
      allow read: if activeRequester()
        && firestore.exists(/databases/(default)/documents/posts/$(postId))
        && isChannelMember(firestore.get(/databases/(default)/documents/posts/$(postId)).data.channelId)
        && resource.contentType in ['image/jpeg','image/png','image/webp','audio/mpeg','audio/mp4','audio/ogg','audio/wav','audio/webm','application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-powerpoint','application/vnd.openxmlformats-officedocument.presentationml.presentation','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','text/plain'];
      allow create: if owns(userId)
        && request.resource.size <= 200 * 1024 * 1024
        && withinQuota(userId)
        && safeStudyFile()
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }
    match /users/{userId}/messages/{fileName} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.size <= 200 * 1024 * 1024
        && withinQuota(userId)
        && safeStudyFile()
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }
    match /users/{userId}/comments/{postId}/{fileName} {
      allow read: if activeRequester()
        && firestore.exists(/databases/(default)/documents/posts/$(postId))
        && isChannelMember(firestore.get(/databases/(default)/documents/posts/$(postId)).data.channelId);
      allow create: if owns(userId)
        && request.resource.size <= 200 * 1024 * 1024
        && withinQuota(userId)
        && (safeImage() || safeAudio())
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }

    match /channels/{channelId}/posts/{postId}/{userId}/{fileName} {
      allow read: if isChannelMember(channelId);
      allow create: if owns(userId) && isChannelMember(channelId)
        && request.resource.size <= 200 * 1024 * 1024
        && withinQuota(userId)
        && safeStudyFile()
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }

    match /channels/{channelId}/comments/{postId}/{commentId}/{userId}/{fileName} {
      allow read: if isChannelMember(channelId);
      allow create: if owns(userId) && isChannelMember(channelId)
        && request.resource.size <= 200 * 1024 * 1024
        && withinQuota(userId)
        && (safeImage() || safeAudio())
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }

    match /conversations/{conversationId}/{userId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      allow create: if owns(userId) && isConversationParticipant(conversationId)
        && request.resource.size <= 200 * 1024 * 1024
        && withinQuota(userId)
        && safeStudyFile()
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if owns(userId);
      allow update: if false;
    }

    // StudyLoop v2 upload sessions. A Function declares every immutable path
    // before the browser is allowed to upload bytes to it.
    function v2Member(channelId) {
      return v2Requester()
        && firestore.exists(/databases/(default)/documents/channels/$(channelId)/members/$(request.auth.uid));
    }
    function validUploadSession(uploadSessionId, attachmentId, expectedPath) {
      return uploadSessionId is string
        && attachmentId is string
        && firestore.exists(/databases/(default)/documents/uploadSessions/$(uploadSessionId))
        && firestore.get(/databases/(default)/documents/uploadSessions/$(uploadSessionId)).data.ownerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/uploadSessions/$(uploadSessionId)).data.status == 'created'
        && firestore.get(/databases/(default)/documents/uploadSessions/$(uploadSessionId)).data.expiresAt > request.time
        && attachmentId in firestore.get(/databases/(default)/documents/uploadSessions/$(uploadSessionId)).data.attachmentIds
        && expectedPath in firestore.get(/databases/(default)/documents/uploadSessions/$(uploadSessionId)).data.allowedPaths;
    }
    function v2SessionAllows(attachmentId, expectedPath) {
      return v2Requester()
        && request.resource.metadata.uploadSessionId is string
        && request.resource.metadata.attachmentId == attachmentId
        && request.resource.metadata.ownerUid == request.auth.uid
        && validUploadSession(request.resource.metadata.uploadSessionId, attachmentId, expectedPath);
    }

    match /profiles/{userId}/avatar/{attachmentId} {
      allow read: if v2Requester();
      allow create: if owns(userId) && resource == null
        && request.resource.size <= 10 * 1024 * 1024
        && safeImage()
        && v2SessionAllows(attachmentId, 'profiles/' + userId + '/avatar/' + attachmentId);
      allow update, delete: if false;
    }

    match /channels/{channelId}/avatar/{attachmentId} {
      allow read: if v2Requester();
      allow create: if v2Member(channelId) && resource == null
        && request.resource.size <= 10 * 1024 * 1024
        && safeImage()
        && v2SessionAllows(attachmentId, 'channels/' + channelId + '/avatar/' + attachmentId);
      allow update, delete: if false;
    }

    match /channels/{channelId}/posts/{postId}/{attachmentId} {
      allow read: if v2Member(channelId);
      allow create: if v2Member(channelId) && resource == null
        && request.resource.size <= 200 * 1024 * 1024
        && safeStudyFile()
        && v2SessionAllows(attachmentId, 'channels/' + channelId + '/posts/' + postId + '/' + attachmentId);
      allow update, delete: if false;
    }

    match /channels/{channelId}/comments/{commentId}/{attachmentId} {
      allow read: if v2Member(channelId);
      allow create: if v2Member(channelId) && resource == null
        && request.resource.size <= 200 * 1024 * 1024
        && (safeImage() || safeAudio())
        && v2SessionAllows(attachmentId, 'channels/' + channelId + '/comments/' + commentId + '/' + attachmentId);
      allow update, delete: if false;
    }

    match /conversations/{conversationId}/messages/{messageId}/{attachmentId} {
      allow read: if v2Requester()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId)/members/$(request.auth.uid));
      allow create: if activeRequester() && resource == null
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId)/members/$(request.auth.uid))
        && request.resource.size <= 200 * 1024 * 1024
        && (safeImage() || safeDocument())
        && v2SessionAllows(attachmentId, 'conversations/' + conversationId + '/messages/' + messageId + '/' + attachmentId);
      allow update, delete: if false;
    }
  }
}
