rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && fileName.matches('[A-Za-z0-9._-]{1,120}');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/saved/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio)/.*|application/pdf')
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/posts/{postId}/{fileName} {
      allow read: if resource != null
        && resource.contentType.matches('(image|audio)/.*|application/pdf');
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio)/.*|application/pdf')
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/messages/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio)/.*|application/pdf')
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/comments/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio)/.*')
        && fileName.matches('[A-Za-z0-9._-]{1,160}');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
